# dc-chatbot local development
#
# Copy to .env and fill in development values only:
#   cp .env.example .env
#
# Do not commit .env. Never put production Discord Bot tokens or provider
# secrets here.

# --- Shared (read by docker compose for api / bot) ---

# Secret for local API auth bypass. Send the same value as x-dev-auth-secret.
LOCAL_AUTH_BYPASS_SECRET=local-auth-bypass-secret

# Cloudflare Access Service Token (fake values are fine for local API + Bot).
CF_ACCESS_CLIENT_ID=local-dev-client-id
CF_ACCESS_CLIENT_SECRET=local-dev-client-secret

# --- Bot Worker (optional: docker compose --profile bot up bot) ---

# Development Discord Application Bot token. Do not use production DISCORD_TOKEN locally.
DISCORD_DEV_TOKEN=

# Guild where the dev bot may respond to mentions.
DISCORD_DEV_GUILD_ID=

# Comma-separated Discord user IDs allowed to DM the dev bot.
DISCORD_DEV_ALLOWED_USER_IDS=

# Leave empty locally. docker-compose.yml forces an empty value in the bot container.
DISCORD_TOKEN=

# --- Host-only: pnpm --filter @dc-chatbot/bot dev (without Compose) ---
#
# DC_CHATBOT_ALLOW_DEV_BOT=true
# DC_CHATBOT_API_BASE_URL=http://localhost:8787

# --- Optional: local API (wrangler dev + local D1) ---

# Root `pnpm dev` and Docker Compose write these local API values to
# apps/api/.dev.vars for Wrangler. For direct `pnpm --filter @dc-chatbot/api dev`,
# copy apps/api/.dev.vars.example to apps/api/.dev.vars and edit it directly.

# LLM provider: fake (default) or nvidia_nim
# LLM_PROVIDER=fake
# NVIDIA_NIM_BEARER_TOKEN=
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Owner route Cloudflare Access JWT verification (optional for local bypass flows).
# CF_ACCESS_TEAM_DOMAIN=team.cloudflareaccess.com
# CF_ACCESS_AUD=replace-with-access-application-aud

# --- Optional: local Web (pnpm --filter @dc-chatbot/web dev) ---

# Dev server proxy target for /api/* (default: http://127.0.0.1:8787).
# Docker Compose sets this to http://api:8787 automatically.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8787

# Local Owner UI auth bypass (development only; never use in production builds).
# VITE_LOCAL_AUTH_BYPASS_SECRET=local-auth-bypass-secret
# VITE_DEV_ACCESS_SUBJECT=local-dev-owner@example.com
# VITE_DEV_OWNER_DISCORD_USER_ID=999999999999999999
# VITE_DEV_OWNER_ROLE=admin_owner

# Production build only. Owner UI uses this as the API origin.
# VITE_API_BASE_URL=http://localhost:8787
