{
  "name": "@dc-chatbot/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/worker.ts"
  },
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --ip 0.0.0.0 --config wrangler.dev.toml",
    "dev:node": "tsx src/local-dev.ts",
    "d1:migrate:local": "wrangler d1 migrations apply dc-chatbot-local --local --config wrangler.dev.toml",
    "d1:seed:local": "wrangler d1 execute dc-chatbot-local --local --config wrangler.dev.toml --file scripts/seed-local-d1.sql",
    "dev:prepare": "pnpm d1:migrate:local && pnpm d1:seed:local",
    "check": "tsc --project tsconfig.json --noEmit",
    "build": "tsc --project tsconfig.json --noEmit",
    "test:e2e": "vitest run test --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@dc-chatbot/data": "workspace:*",
    "@dc-chatbot/domain": "workspace:*",
    "@dc-chatbot/provider": "workspace:*",
    "@dc-chatbot/shared": "workspace:*",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260619.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.51.0"
  }
}
